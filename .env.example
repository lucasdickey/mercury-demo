# Steward runs against the Mercury SANDBOX only. There is no production token slot on purpose.
MERCURY_SANDBOX_API_TOKEN=secret-token:mercury_sandbox_...
# Optional override; defaults to https://api-sandbox.mercury.com/api/v1
# MERCURY_BASE_URL=

ANTHROPIC_API_KEY=sk-ant-...
# STEWARD_MODEL=claude-sonnet-5

# MCP endpoint lives at /api/mcp/<MCP_PATH_SECRET>. 32+ random chars.  openssl rand -hex 24
MCP_PATH_SECRET=
# HMAC key for MRTR requestState and approve links. 32+ chars.  openssl rand -hex 32
STATE_SECRET=

# Used to build approve URLs; on Vercel VERCEL_URL is used when this is unset.
# PUBLIC_BASE_URL=https://steward.example.com

# Password gate for the deployed demo (HTTP Basic, user: steward). Unset = no gate (local dev).
STEWARD_PASSWORD=
